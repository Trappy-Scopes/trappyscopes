#!/usr/bin/env bash
## Start Trappy-Scopes from this checkout, with the scope's venv.
##
##   ./trappyscope              Launch normally (config, sync, repos, then the CLI)
##   ./trappyscope --launcher   the launcher menu
##
## Uses ~/trappyvenv if it exists (TRAPPY_VENV overrides the path), otherwise
## the python3 on PATH. Same entry point as the `trappyscope` command that
## `pip install -e .` puts in the venv; this one works before the venv is
## activated, and before that install has run (see docs/notes/installation.md).

cd "$(dirname "$(readlink -f "$0")")" || exit 1

VENV="${TRAPPY_VENV:-$HOME/trappyvenv}"
if [ -x "$VENV/bin/python" ]; then
	PY="$VENV/bin/python"
else
	PY="python3"
fi

exec "$PY" -m launcher "$@"
